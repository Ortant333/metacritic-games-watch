# Скопировать в .env и заполнить. Без LLM_API_KEY резюме пишутся
# извлекающим способом (без сети и без денег) - сервис работает и так.
MC_PORT=8095
MC_DB=data/mc.db
GAMES_PER_RUN=20
LETSPLAY_PER_RUN=6
LLM_API_BASE=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-flash
LLM_DAILY_BUDGET=120
